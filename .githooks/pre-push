#!/usr/bin/env bash
# Type check + test suite before every push: bun runs TypeScript without
# checking it, so a call to a method an interface never had (the
# gh.issueListOpen class in docs/development.md) only fails in production.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bun run check
