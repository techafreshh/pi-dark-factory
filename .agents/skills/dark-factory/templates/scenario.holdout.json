{
  "name": "holdout",
  "port": "second",
  "start": "node server.js",
  "readiness_path": "/health",
  "probes": [
    { "id": "malformed-json-400", "description": "a malformed JSON body gets a 4xx quickly, never a 500 or a hang",
      "command": "curl -s -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:$PORT/items -H 'content-type: application/json' -d '{broken'",
      "expect": "status:400 max_ms:5000" },
    { "id": "missing-field-422", "description": "a body without the required field is rejected",
      "command": "curl -s -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:$PORT/items -H 'content-type: application/json' -d '{}'",
      "expect": "status_in:400,422" },
    { "id": "unknown-id-404", "description": "a resource that doesn't exist answers 404",
      "command": "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/items/999999",
      "expect": "status:404" },
    { "id": "markup-inert", "description": "markup in input comes back escaped, never executable",
      "command": "curl -s -w '\\n%{http_code}' -X POST http://127.0.0.1:$PORT/items -H 'content-type: application/json' -d '{\"title\":\"<script>x</script>\"}'",
      "expect": "status:201 body_matches:^(?!.*<script>)" }
  ]
}
