{
  "name": "runtime",
  "port": "first",
  "start": "node server.js",
  "readiness_path": "/health",
  "probes": [
    { "id": "health-200", "description": "GET /health answers 200 (the command prints the code; status: reads the last line)",
      "command": "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/health", "expect": "status:200" },
    { "id": "health-body", "description": "GET /health returns JSON with ok:true (json: needs all of stdout to be one document)",
      "command": "curl -s http://127.0.0.1:$PORT/health", "expect": "json:ok=true" },
    { "id": "create-item", "description": "POST /items creates an item and echoes it",
      "command": "curl -s -w '\\n%{http_code}' -X POST http://127.0.0.1:$PORT/items -H 'content-type: application/json' -d '{\"title\":\"a\"}'",
      "expect": "status:201 body_contains:\"title\":\"a\"", "timeout_ms": 10000 },
    { "id": "unknown-404", "description": "unknown paths answer 404, never 5xx",
      "command": "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/definitely-not-a-route",
      "expect": "status:404" }
  ]
}
