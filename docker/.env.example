# Copy to docker/.env and fill it in:  cp .env.example .env && chmod 600 .env
# docker/.env is gitignored and stays out of the image. Never commit a real value.
# The dark-factory-setup skill can write this file for you without echoing the secrets.

# ── Required ────────────────────────────────────────────────────────────────
# The API key every client sends (X-Api-Key). The daemon refuses to start without it.
# Generate one:  openssl rand -hex 32
FACTORY_API_KEY=
# A GitHub token that can read issues, push branches, open and merge PRs on your repos.
# A fine-grained token limited to those repos is the safer choice. A classic token needs the
# `repo` scope; `read:org` as well lets `gh auth login` accept it, but it is not required.
GH_TOKEN=

# ── Model keys ──────────────────────────────────────────────────────────────
# Fill the providers your repo configs use; leave the rest empty. Empty ones are dropped at start.
# OAuth logins are the alternative, and they persist in a volume:
#   docker compose run --rm -it factoryd pi      (then type /login)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Web grounding (web_search + web_fetch) for lap agents
TINYFISH_API_KEY=
# Cloud machine lanes, for repos whose env.mode is instabox or boxd
INSTABOX_API_KEY=
BOXD_API_KEY=
# Commit identity. When empty, the name and noreply email are derived from GH_TOKEN.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Limits (the defaults are conservative; compose.yml applies them when unset) ──
# Repos ticking at once. Host-mode laps run one at a time per repo, so this is how many repos
# build at the same time.
PI_FACTORY_CONCURRENCY=1
# Minutes between scheduler passes, on the wall clock (15 = :00 :15 :30 :45)
PDF_SCHEDULER_MINUTES=15
# 1 = also run one pass shortly after the stack starts (a laptop that slept catches up)
PDF_TICK_ON_START=1
# Concurrent cloud machines per platform. Uncomment to change (defaults shown).
# PDF_POOL_INSTABOX=5
# PDF_POOL_BOXD=10
# Host ports (loopback only)
FACTORYD_HOST_PORT=8077
DASHBOARD_HOST_PORT=8787
# CPU and memory caps for factoryd: set them, then uncomment `cpus` and `mem_limit` in compose.yml
# FACTORY_CPUS=2
# FACTORY_MEMORY=4g
