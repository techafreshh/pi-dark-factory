#!/usr/bin/env python3
"""factory-remote — drive a pi-dark-factory over HTTPS. Python 3 stdlib only.

Env:
  FACTORY_URL      e.g. https://pi-factory.techa.pro
  FACTORY_API_KEY  the key from the VPS (/home/factory/factoryd.env)

Verbs (mirror the foreman CLI):
  health                                  open endpoint — connectivity check
  models                                  the LIVE provider roster (models.json, keys stripped)
                                          — model discovery; config writes validate against it
  status [--repo SLUG] [--raw]            ledger, laps, stages, chain depth
  logs  [--repo SLUG] [--tail N]          laps.log tail (the audit spine)
  session SLUG [--follow] [--think]       human-readable pi session view
                                          [--issue N]; --follow streams live
                                          and auto-reconnects on drops
  onboard OWNER/NAME                      config + scenario templates + port pair
  config SLUG [--json '{...}']            read the FULL effective config; with --json, deep-merge a patch
                                          (models, env, merge, timeouts)
  scenario SLUG runtime|holdout --file F  write + server-side validate a scenario
  prove-gates SLUG                        plant every probe against a product-shaped stub; gates must trip
  discoveries SLUG [--file]               list harvested reviewer observations; --file opens deduped issues
  scenario SLUG runtime|holdout --test     execute the STORED scenario without a lap
  backlog SLUG --prd-file F [--max N]     slice a PRD; previews unless --create
  tick SLUG                               fire a lap now (pidfile arbitrates with the timer)
  pause SLUG / unpause SLUG               pull a repo off the tick wheel / put it back
  unblock SLUG ISSUE [--prune]            drop the ledger row (optionally close PR/branch/worktree)
  cleanup                                 prune caches, kill stale pi workers
  doctor                                  connectivity + auth + version check

Exit code 0 = success, 1 = error (message on stderr).
"""
import argparse
import http.client
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.request

TIMEOUT_FAST = 60
TIMEOUT_SLOW = 900  # backlog slicing runs an LLM server-side


def _cfg() -> tuple[str, str]:
    url = os.environ.get("FACTORY_URL", "").rstrip("/")
    key = os.environ.get("FACTORY_API_KEY", "")
    if not url or not key:
        # stored-config fallback so the client runs from ANY directory
        # (e.g. the pilot project being onboarded) without env setup —
        # the skill's Connect section documents these files (mode 600)
        cfgdir = os.path.expanduser("~/.config/factory-remote")
        try:
            url = url or open(os.path.join(cfgdir, "url"), encoding="utf-8").read().strip()
            key = key or open(os.path.join(cfgdir, "key"), encoding="utf-8").read().strip()
        except OSError:
            pass
    if not url or not key:
        die("FACTORY_URL and FACTORY_API_KEY must be set, or stored in ~/.config/factory-remote/{url,key} (see factory-remote --help)")
    return url, key


def _api(method: str, path: str, body: dict | None = None, timeout: int = TIMEOUT_FAST, allow_401: bool = False, allow_status: tuple = ()):
    url, key = _cfg()
    req = urllib.request.Request(
        url + path,
        method=method,
        headers={"Content-Type": "application/json", **({} if allow_401 else {"X-Api-Key": key})},
        data=json.dumps(body).encode() if body is not None else None,
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        if allow_401:
            return e.code, {}
        try:
            payload = json.loads(e.read() or b"{}")
        except Exception:
            payload = {}
        if e.code in allow_status:
            return e.code, payload
        die(f"{method} {path} -> HTTP {e.code}: {payload.get('error', payload)}")
    except urllib.error.URLError as e:
        die(f"{method} {path} failed to connect: {e.reason} — factoryd down? wrong FACTORY_URL?")


def die(msg: str):
    print(msg, file=sys.stderr)
    sys.exit(1)


def _print_slugs(prefix: str, rows: list, key: str):
    if rows:
        print(prefix)
        for r in rows:
            print(f"  {json.dumps(r, ensure_ascii=False)[:240]}")


# ── commands ─────────────────────────────────────────────────────────────────

def _url() -> str:
    url = os.environ.get("FACTORY_URL", "").rstrip("/")
    if not url:
        try:
            url = open(os.path.join(os.path.expanduser("~/.config/factory-remote"), "url"), encoding="utf-8").read().strip()
        except OSError:
            pass
    if not url:
        die("FACTORY_URL is not set (or stored in ~/.config/factory-remote/url)")
    return url


def cmd_health(_a):
    req = urllib.request.Request(_url() + "/health")
    with urllib.request.urlopen(req, timeout=10) as r:
        print(json.dumps(json.loads(r.read())))


def cmd_doctor(_a):
    _cfg()
    code, body = _api("GET", "/health", allow_401=True)
    if code != 200:
        die(f"/health answered {code} — factoryd is not healthy")
    print(f"factoryd: {body.get('service')} v{body.get('version')} — reachable")
    wt = body.get("web_tools") or {}
    if wt:
        if wt.get("extension_on_host") and wt.get("key_set"):
            print("web tools: OK — pi extension installed, TINYFISH_API_KEY set")
        else:
            missing = []
            if not wt.get("extension_on_host"):
                missing.append("pi extension not synced to ~/.pi/agent/extensions (a lap will install it on first stage)")
            if not wt.get("key_set"):
                missing.append("TINYFISH_API_KEY unset in factoryd.env — web_search/web_fetch will error until it is")
            print("web tools: " + "; ".join(missing))
    sb = body.get("shared_base") or {}
    if sb.get("snapshot"):
        print(f"shared base: {sb['snapshot']} — {sb.get('template', 'template ?')}, baked {sb.get('bakedAt', '?')[:10]}")
        if sb.get("contents"):
            print(f"  contents: {sb['contents']}")
    else:
        print("shared base: UNMAPPED — write state/base-snapshot.json on the VPS (instabox repos naming 'shared-base' cannot boot until then)")
    code, body = _api("GET", "/status")
    if code != 200:
        die(f"/status answered {code} — check FACTORY_API_KEY")
    repos = body.get("repos", [])
    print(f"auth OK — {len(repos)} repo(s) onboarded")
    _print_slugs("repos:", repos, "slug")


def cmd_status(a):
    path = "/status" + (f"?slug={a.repo}" if a.repo else "")
    code, body = _api("GET", path)
    if a.raw:
        print(json.dumps(body, indent=2))
        return
    for r in body.get("repos", []):
        chain = r.get("chain")
        chain_s = "unknown (GitHub probe >5s)" if chain == -1 else ("none (all delivered/blocked)" if chain == 0 else str(chain))
        print(f"{r.get('slug')} ({r.get('repo')}) — claimable chain: {chain_s}, in flight: {r.get('in_flight')}")
    print("\n== ledger ==")
    for i in body.get("issues", []):
        print(f"#{i['issue_number']} {i['repo']} [{i['state']}] attempts={i['attempts']}"
              f"{' PR#' + str(i['pr']) if i.get('pr') else ''} — {(i.get('last_error') or '')[:120]}")
    print("\n== recent laps ==")
    for l in body.get("laps", []):
        print(f"#{l['id']} {l['repo']} issue={l.get('issue_number') or '-'} {l.get('outcome') or '…'} {(l.get('detail') or '')[:100]}")
    print("\n== recent stages ==")
    for s in body.get("stages", []):
        print(f"#{s['id']} {s['stage']} a{s['attempt']} {s['model']} {s.get('exit') or '…'} tok={s.get('input_tokens')}/{s.get('output_tokens')}")
    wts = body.get("worktrees", [])
    if wts:
        print("\n== worktrees ==")
        for w in wts:
            print(f"  {w}")


def cmd_logs(a):
    qs = []
    if a.repo:
        qs.append(f"slug={a.repo}")
    if a.tail:
        qs.append(f"tail={a.tail}")
    code, body = _api("GET", "/logs" + ("?" + "&".join(qs) if qs else ""))
    for line in body.get("lines", []):
        print(line)


def _session_stream(a):
    """One streaming attempt; any byte-level transport error propagates."""
    url, key = _cfg()
    qs = []
    if a.follow:
        qs.append("follow=1")
    if a.think:
        qs.append("think=1")
    if a.issue:
        qs.append(f"issue={a.issue}")
    path = f"/session/{a.slug}" + ("?" + "&".join(qs) if qs else "")
    req = urllib.request.Request(url + path, headers={"X-Api-Key": key})
    try:
        with urllib.request.urlopen(req, timeout=120 if a.follow else TIMEOUT_FAST) as r:
            if r.status != 200:
                die(f"GET {path} -> HTTP {r.status}")
            # line iteration, not read(4096): chunked reads block until the
            # full byte count arrives, which swallows stream trickles
            # entirely (heartbeats/tool events never reach stdout in time) —
            # iterating yields each line the moment it lands
            for raw in r:
                sys.stdout.write(raw.decode("utf-8", "replace"))
                sys.stdout.flush()
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read() or b"{}")
        except Exception:
            payload = {}
        die(f"GET {path} -> HTTP {e.code}: {payload.get('error', payload)}")


def cmd_session(a):
    """Human-readable view of the agent's live pi session (newest for slug)."""
    while True:
        try:
            _session_stream(a)
            if not a.follow:
                return
            # a follow stream only "ends normally" if the server closed it
            # (4h cap) — reconnect keeps the monitor useful
            print("\n── stream ended by server, reconnecting in 5s (Ctrl-C to stop) ──", flush=True)
            time.sleep(5)
        except KeyboardInterrupt:
            print("\nbye")
            return
        except (http.client.IncompleteRead, http.client.RemoteDisconnected,
                http.client.BadStatusLine, ConnectionResetError, TimeoutError,
                socket.timeout, urllib.error.URLError) as e:
            if not a.follow:
                die(f"session stream failed: {e}")
            print("\n── stream dropped, reconnecting in 5s (Ctrl-C to stop) ──", flush=True)
            time.sleep(5)


def cmd_onboard(a):
    code, body = _api("POST", "/repos", {"repo": a.repo}, timeout=TIMEOUT_FAST)
    if body.get("already"):
        print(f"already onboarded: {body['config_path']}")
        return
    print(f"onboarded {body['repo']} (slug: {body['slug']}, branch: {body['default_branch']}, ports: {' + '.join(map(str, body['ports']))})")
    print("wrote:")
    for f in body["config_written"]:
        print(f"  {f}")
    print("next: push your config decisions with the config verb (models, env, required_checks);")
    print("next: push scenarios with the scenario verb;")
    print("then backlog + tick.")


def cmd_prove_gates(a):
    code, resp = _api("POST", f"/repos/{a.slug}/prove-gates", {}, timeout=TIMEOUT_SLOW)
    print(json.dumps(resp, indent=2))
    sys.exit(0 if resp.get("verdict") == "healthy" else 1)


def cmd_discoveries(a):
    code, resp = _api("POST", f"/repos/{a.slug}/discoveries", {"file": a.file}, timeout=TIMEOUT_SLOW)
    if not a.file:
        for d in resp.get("discoveries", []):
            print(f"#{d['issue']} (attempt {d['attempt']}) {d['title']}\n  {d['claim']}\n  why: {d['why']}")
        print(f"-- {resp.get('count', 0)} discovery(ies); re-run with --file to open deduped issues")
    else:
        for f in resp.get("filed", []):
            print(f"filed #{f['issue']}: {f['title']}")
        print(f"-- {len(resp.get('filed', []))} filed of {resp.get('count', 0)} harvested")


def cmd_scenario(a):
    if a.kind not in ("runtime", "holdout"):
        die("kind must be runtime or holdout")
    if a.dump:
        code, body = _api("GET", f"/repos/{a.slug}/scenario?kind={a.kind}")
        print(json.dumps(body.get("scenario"), indent=2))
        return
    if a.test:
        body = {"kind": a.kind}
        if a.branch:
            body["branch"] = a.branch
        code, resp = _api("POST", f"/repos/{a.slug}/scenario/test", body, timeout=TIMEOUT_SLOW)
        r = resp.get("result") or {}
        where = f"machine {resp.get('machine')}" if resp.get("machine") else "host worktree"
        print(f"scenario {a.kind} TEST vs {resp.get('branch')} ({where})")
        if r.get("error"):
            print(f"  SCENARIO ERROR: {r['error']}")
        for p in r.get("results", []):
            mark = "ok " if p.get("pass") else "FAIL"
            print(f"  [{mark}] {p.get('id')} — {str(p.get('detail', ''))[:140]}")
        print("VERDICT:", "ALL GREEN" if r.get("pass") else "FAILED")
        sys.exit(0 if r.get("pass") else 1)
    if not a.file:
        die("provide --file F (write or --lint), --dump, or --test (execute the stored scenario without a lap)")
    content = open(a.file, encoding="utf-8").read()
    if a.lint:
        code, body = _api("PUT", f"/repos/{a.slug}/scenario", {"kind": a.kind, "content": content, "lint": True})
        print(f"LINT OK for {a.kind}.json (nothing written)")
        for w in body.get("warnings", []):
            print(f"  warn: {w}")
        return
    code, body = _api("PUT", f"/repos/{a.slug}/scenario", {"kind": a.kind, "content": content})
    print(f"{a.kind}.json updated for {a.slug}: {body.get('path')}")


def cmd_backlog(a):
    if not os.path.exists(a.prd_file):
        die(f"PRD file not found: {a.prd_file}")
    prd = open(a.prd_file, encoding="utf-8").read()
    code, body = _api(
        "POST", f"/repos/{a.slug}/backlog",
        {"prd_text": prd, "dry_run": not a.create, "max": a.max},
        timeout=TIMEOUT_SLOW,
    )
    print(f"sliced {body['sliced']} issues; {body['existing']} already exist (deduped by title)")
    if not a.create:
        print("PREVIEW (run again with --create to publish):")
        for i, p in enumerate(body["preview"], 1):
            print(f"{i}. {p['title']}" + (f" (depends: {', '.join(map(str, p['depends']))})" if p["depends"] else ""))
    else:
        print("created / resolved:")
        for c in body["created"]:
            print(f"  #{c['number']}: {c['title']}")


def cmd_tick(a):
    code, body = _api("POST", f"/repos/{a.slug}/tick", {}, allow_status=(409,))
    if body.get("queued") is False or code == 409:
        die("tick SKIPPED: " + str(body.get("skipped")) + " — retry when the running tick settles (only a `queued: <slug> #N` log line means a lap truly started)")
    print(f"lap dispatched for {body['slug']} — follow with: factory-remote status --repo {a.slug} (or logs)")


def cmd_models(_a):
    code, body = _api("GET", "/models", timeout=TIMEOUT_FAST)
    providers = body.get("providers") or []
    if not providers:
        print(body.get("note") or "no providers configured")
        return
    for p in providers:
        print(f"{p['name']} — {p.get('api')} · {p.get('baseUrl')}")
        for m in p.get("models") or []:
            think = m.get("thinking")
            if think:
                t = f" · thinking: {','.join(think['supported'])}"
                if think.get("unsupported"):
                    t += f" (NOT: {','.join(think['unsupported'])})"
            else:
                t = " · thinking: provider default"
            print(f"  {m['id']} — reasoning={'yes' if m.get('reasoning') else 'no'} · ctx={m.get('contextWindow')}{t}")
    print("\n(config writes validate against this roster: unknown providers and unsupported thinking levels reject)")


def cmd_pause(a):
    code, body = _api("POST", f"/repos/{a.slug}/pause", {}, timeout=TIMEOUT_FAST)
    print(f"{a.slug} PAUSED — ticks skip it (an in-flight lap finishes); factory-remote unpause {a.slug} to resume")


def cmd_unpause(a):
    code, body = _api("POST", f"/repos/{a.slug}/unpause", {}, timeout=TIMEOUT_FAST)
    print(f"{a.slug} UNPAUSED — the next tick picks it up; fire one now: factory-remote tick {a.slug}")


def cmd_unblock(a):
    code, body = _api("POST", f"/repos/{a.slug}/unblock",
                      {"issue": a.issue, "prune": a.prune, "force": a.force}, allow_status=(409,))
    if body.get("refused"):
        print(f"REFUSED ({body['refused']}): {body.get('note')}")
        sys.exit(1)
    print(json.dumps(body, indent=2))


def cmd_config(a):
    if not a.json:
        code, body = _api("GET", "/repos/" + a.slug + "/config")
        # the COMPLETE effective config — a filtered summary here once hid
        # env.instabox.*, thinking and pass_env, and diagnosing one config
        # typo meant cat-ing another repo's config on the VPS (magpie
        # postmortem 2026-10-25, incidents 5/7)
        print(f"effective config for {a.slug} — complete, nothing filtered:")
        print(json.dumps(body.get("config") or {}, indent=2))
        return
    patch = json.loads(a.json)
    code, body = _api("POST", "/repos/" + a.slug + "/config", patch, timeout=TIMEOUT_FAST)
    print("config updated: " + str(body.get("config_path")))
    print(json.dumps(body.get("config") or {}, indent=2))


def cmd_cleanup(_a):
    code, body = _api("POST", "/cleanup", {}, timeout=TIMEOUT_FAST)
    for line in body.get("log", []):
        print(line)


def main():
    p = argparse.ArgumentParser(description="factory-remote — remote control for a pi-dark-factory")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("health")
    sub.add_parser("doctor")
    sub.add_parser("models")
    sp = sub.add_parser("status"); sp.add_argument("--repo"); sp.add_argument("--raw", action="store_true")
    sp = sub.add_parser("logs"); sp.add_argument("--repo"); sp.add_argument("--tail", type=int, default=200)
    sp = sub.add_parser("session"); sp.add_argument("slug"); sp.add_argument("--follow", "-f", action="store_true")
    sp.add_argument("--think", action="store_true", help="include the model's reasoning text (capped per turn)")
    sp.add_argument("--issue", type=int, help="pin a specific issue's session (default: newest for the repo)")
    sp = sub.add_parser("onboard"); sp.add_argument("repo", metavar="OWNER/NAME")
    sp = sub.add_parser("scenario"); sp.add_argument("slug"); sp.add_argument("kind", choices=["runtime", "holdout"])
    sp.add_argument("--file", help="scenario JSON to write (or validate with --lint)")
    sp.add_argument("--lint", action="store_true", help="validate + lint WITHOUT writing — run this before every write")
    sp.add_argument("--dump", action="store_true", help="print the stored scenario instead of writing")
    sp.add_argument("--test", action="store_true", help="execute the STORED scenario against a branch WITHOUT spending a lap (the verifier's own test bench)")
    sp.add_argument("--branch", help="branch for --test (default: the repo's default branch — test the merged state)")
    sp = sub.add_parser("backlog"); sp.add_argument("slug"); sp.add_argument("--prd-file", required=True); sp.add_argument("--max", type=int, default=40); sp.add_argument("--create", action="store_true")
    sp = sub.add_parser("prove-gates"); sp.add_argument("slug")
    sp = sub.add_parser("discoveries"); sp.add_argument("slug"); sp.add_argument("--file", action="store_true", help="open deduped [discovery] issues (preview default: list only)")
    sp = sub.add_parser("config"); sp.add_argument("slug"); sp.add_argument("--json",
                        help="config patch JSON: models, env, merge, timeouts keys (omit to READ the effective config)")
    sp = sub.add_parser("tick"); sp.add_argument("slug")
    sp = sub.add_parser("pause"); sp.add_argument("slug")
    sp = sub.add_parser("unpause"); sp.add_argument("slug")
    sp = sub.add_parser("unblock"); sp.add_argument("slug"); sp.add_argument("issue", type=int); sp.add_argument("--prune", action="store_true"); sp.add_argument("--force", action="store_true",
                        help="override the in-progress guard (only after verifying the lap is dead)")
    sub.add_parser("cleanup")
    a = p.parse_args()
    table = {
        "health": cmd_health, "doctor": cmd_doctor, "status": cmd_status, "logs": cmd_logs,
        "session": cmd_session, "config": cmd_config, "onboard": cmd_onboard, "scenario": cmd_scenario,
        "prove-gates": cmd_prove_gates, "discoveries": cmd_discoveries,
        "models": cmd_models,
        "backlog": cmd_backlog, "tick": cmd_tick, "unblock": cmd_unblock, "cleanup": cmd_cleanup,
        "pause": cmd_pause, "unpause": cmd_unpause,
    }
    table[a.cmd](a)


if __name__ == "__main__":
    main()
